# 复制为 .env 后填写；不要提交真实密钥。
# docker compose 会自动读取同目录下的 .env。

# 必填：匿名会话 HMAC 密钥（至少 32 字节随机字符串）
CLIENT_TOKEN_SECRET=请替换为随机长字符串
# 可选：管理员删除令牌；不设置则只能靠发布者删除令牌
COMMUNITY_ADMIN_TOKEN=

# 可选：允许跨域调用 API 的来源，逗号分隔
ALLOWED_ORIGINS=
# 可选：页面与 API 不同源时填写 API 来源（用于 CSP connect-src）
PUBLIC_API_ORIGIN=
# 位于 Caddy / Nginx 之后时设为 true，限流会读取 X-Forwarded-For
TRUST_PROXY=true

# PostgreSQL
POSTGRES_PASSWORD=请替换为强密码

# MinIO / S3 兼容对象存储
MINIO_ROOT_USER=fangyan
MINIO_ROOT_PASSWORD=请替换为强密码
# 浏览器可访问的桶地址；生产环境换成 CDN 域名
S3_PUBLIC_BASE_URL=http://localhost:9000/fangyan-audio
# 浏览器访问对象存储的 Origin（用于 CSP）
S3_PUBLIC_ORIGIN=http://localhost:9000

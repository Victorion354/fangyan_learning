# 本地/单机反向代理示例
#
# - 静态文件由 Caddy 直接托管（生产可换成 CDN / 对象存储）
# - /api/* 反向代理到 Node 服务
# - SSE 关闭缓冲，保证留言实时刷新
#
# 生产环境请把站点地址改成真实域名，并删除 auto_https off 以启用自动 HTTPS。

{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy app:8787 {
			flush_interval -1
		}
	}

	handle {
		@private path /data/* /db/* /deploy/* /lib/* /tests/* /scripts/* /node_modules/* /server.js /package.json /package-lock.json /Dockerfile /docker-compose.yml /README.md /readme.md /.git/* /.github/* /.env* /.dockerignore
		respond @private 404

		root * /srv
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net https://unpkg.com; script-src-attr 'none'; style-src 'self' https://cdn.jsdelivr.net https://unpkg.com; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https://*.tianditu.gov.cn https://cdn.jsdelivr.net https://unpkg.com {$S3_PUBLIC_ORIGIN}; font-src 'self' data:; media-src 'self' data: blob: {$S3_PUBLIC_ORIGIN}; connect-src 'self' https://*.tianditu.gov.cn {$S3_PUBLIC_ORIGIN} {$PUBLIC_API_ORIGIN}; worker-src 'self' blob:; manifest-src 'self'"
		-Server
	}

	@immutable path /assets/*.js /assets/*.css
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@images path /assets/*.webp /assets/*.jpg /assets/*.png /assets/*.svg
	header @images Cache-Control "public, max-age=604800"

	@html path / /index.html /fangyan-detail.html /方言学习页.html /privacy.html /data.html /action.html /methods.html
	header @html Cache-Control "no-cache"
}
